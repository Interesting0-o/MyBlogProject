BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
DATABASE_URL=sqlite://resource/sudo4.db
VITE_API_BASE_URL=/api

# 日志级别（tracing EnvFilter 语法，如 sudo4_api=debug）。
# 未设置时：debug 构建输出全部日志，release 构建仅输出 warning 及以上。
RUST_LOG=

# 后台管理员（生成方式见 README「后台管理」一节）
# 密码哈希是 bcrypt，值里有 $，写进 .env 时务必用单引号包起来
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=
ADMIN_TOKEN_HOURS=12
